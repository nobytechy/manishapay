!.env.production.example
backend/.env*
!backend/.env.example
frontend/.env*
!frontend/.env.example
!frontend/.env.production.example

# ── Logs / temporary files ──────────────────────────────────────────────
*.log
*.zip
*.tar.gz
.DS_Store
Thumbs.db

# ── Editor / IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Test coverage / cache ───────────────────────────────────────────────
coverage/
.nyc_output/

# ── Claude / dev scratch ────────────────────────────────────────────────
.claude/
