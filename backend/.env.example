# ─── Server ──────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=production
LOG_LEVEL=info

# ─── Supabase (the SHARED project — same as chikoro / church) ────────
# Settings → API → URL / service_role / anon
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE=eyJ...                 # SECRET — server-side only
SUPABASE_ANON_KEY=eyJ...

# ─── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-with-openssl-rand-hex-32
JWT_EXPIRY=1h
REFRESH_EXPIRY=30d

# ─── Master encryption key for merchant PayNow credentials ───────────
# Generate ONCE with `openssl rand -hex 32`. NEVER change in production
# without first running the rotation script — every encrypted credential
# becomes unrecoverable otherwise.
MANISHAPAY_MASTER_KEY=change-me-openssl-rand-hex-32

# ─── PayNow defaults (used when a project has no return/result URLs) ─
PAYNOW_RETURN_URL=https://pay.aizim.co.zw/return
PAYNOW_RESULT_URL=https://pay.aizim.co.zw/api/v1/webhook
PAYNOW_API_BASE=https://www.paynow.co.zw/interface

# ─── Simulator hosting (this server, public) ─────────────────────────
SIMULATOR_BASE_URL=https://pay.aizim.co.zw

# ─── ManishaPay's OWN PayNow account (for billing developers later) ──
# Leave blank until you're ready to send invoices.
# MANISHAPAY_OWN_PAYNOW_INTEGRATION_ID=
# MANISHAPAY_OWN_PAYNOW_INTEGRATION_KEY=

# ─── Shared SANDBOX PayNow test integration ──────────────────────────
# A single PayNow TEST integration the sandbox falls back to when a project
# has no test creds of its own — so devs hit real PayNow test with zero setup.
# Leave blank to keep the no-creds path on the built-in simulator instead.
PAYNOW_TEST_INTEGRATION_ID=
PAYNOW_TEST_INTEGRATION_KEY=

# ─── Limits ──────────────────────────────────────────────────────────
RATE_LIMIT_DEV=100
RATE_LIMIT_ADMIN=1000
MAX_RETRY_ATTEMPTS=3

# ─── Reconciliation sweep (missed-webhook safety net) ────────────────
# Re-polls pending, non-simulated transactions against PayNow and fires the
# merchant webhook if a payment resolved while we weren't listening.
#   CRON_SECRET           — bearer token guarding POST /v1/reconcile so an
#                           external scheduler can drive the sweep. Unset =
#                           the HTTP trigger is disabled. `openssl rand -hex 24`
#   RECONCILE_INTERVAL_MS — in-process sweep cadence (ms). 0 disables it; only
#                           useful when the process stays awake (keep-warm).
CRON_SECRET=
RECONCILE_INTERVAL_MS=0
RECONCILE_MIN_AGE_MINUTES=2
RECONCILE_MAX_AGE_HOURS=48
RECONCILE_BATCH_SIZE=50

# ─── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of origins that may call the API from a browser.
ALLOW_CORS_ORIGINS=https://pay.aizim.co.zw,http://localhost:5173
