{
  "id": "stripe",
  "name": "Stripe",
  "aliases": ["Stripe Checkout", "Stripe Payments"],
  "homepage": "https://stripe.com",
  "docs_url": "https://docs.stripe.com/api",
  "category": "global-card",
  "regions": ["Global"],
  "countries": ["US", "GB", "EU", "ZA", "global"],
  "currencies": ["USD", "EUR", "GBP", "ZAR", "and 135+ presentment currencies"],
  "methods": ["card", "apple_pay", "google_pay", "link", "bank_debit", "bnpl"],
  "auth": {
    "model": "bearer-secret-key",
    "key_types": ["sk_test_", "sk_live_", "pk_test_", "pk_live_", "rk_", "whsec_"],
    "sandbox_instant": true,
    "kyc_required_for_live": true
  },
  "initiate": {
    "flow": "redirect",
    "endpoint": "POST https://api.stripe.com/v1/checkout/sessions",
    "http_method": "POST",
    "required_params": ["mode", "line_items", "success_url"],
    "returns": ["id", "url", "payment_status", "status"],
    "amount_unit": "minor-subunit"
  },
  "status": {
    "mechanisms": ["webhook", "poll"],
    "webhook_verification": "Header 'Stripe-Signature: t=..,v1=..'; HMAC-SHA256 over '{t}.'+rawBody vs whsec_; 300s tolerance; RAW body required",
    "raw_status_values": ["paid", "unpaid", "no_payment_required", "succeeded", "processing", "requires_action", "requires_confirmation", "requires_capture", "requires_payment_method", "canceled"],
    "status_map": {
      "paid": "paid",
      "succeeded": "paid",
      "no_payment_required": "paid",
      "unpaid": "pending",
      "processing": "pending",
      "requires_action": "pending",
      "requires_confirmation": "pending",
      "requires_capture": "pending",
      "requires_payment_method": "failed",
      "canceled": "failed",
      "charge.dispute.created": "disputed",
      "charge.refunded": "refunded"
    }
  },
  "capabilities": {
    "redirect": true,
    "poll": true,
    "webhook": true,
    "mobile_push": false,
    "refund": true,
    "recurring": true
  },
  "credentials_required": [
    { "key": "secretKey", "label": "Secret Key (sk_)", "secret": true, "note": "server-side auth for all calls" },
    { "key": "webhookSecret", "label": "Webhook Signing Secret (whsec_)", "secret": true, "note": "needed to verify inbound events" }
  ],
  "sandbox": {
    "test_credentials": { "note": "test keys instant from dashboard.stripe.com/test/apikeys, no KYC" },
    "test_cards": [
      { "number": "4242424242424242", "result": "success" },
      { "number": "4000000000000002", "result": "generic_decline" },
      { "number": "4000000000009995", "result": "insufficient_funds" },
      { "number": "4000000000003220", "result": "3ds_required" }
    ],
    "notes": "any future expiry, any CVC. Zero-decimal currencies (JPY,KRW,VND,+~13) use whole units."
  },
  "pain_points": [
    { "problem": "Webhook signature verification fails", "cause": "JSON body-parser mutates the raw body before HMAC", "mitigation": "Verify against the raw request bytes, before any JSON parser; dedicate a raw-body route", "severity": "critical", "source": "https://docs.stripe.com/webhooks/signature" },
    { "problem": "Duplicate order processing", "cause": "Stripe delivers events at-least-once (duplicates)", "mitigation": "Dedupe on event id; make side-effects idempotent", "severity": "high", "source": "https://docs.stripe.com/webhooks" },
    { "problem": "Out-of-order events / webhook beats redirect", "cause": "Events not guaranteed chronological", "mitigation": "Monotonic state machine keyed on your txn id; re-fetch object; never gate fulfillment on redirect", "severity": "high", "source": "https://docs.stripe.com/payments/checkout/fulfill-orders" },
    { "problem": "100x over/undercharge", "cause": "cents vs zero-decimal currency confusion", "mitigation": "Single amount format in your API; convert to minor unit internally via a zero-decimal table", "severity": "high", "source": "https://docs.stripe.com/currencies" },
    { "problem": "SCA/3DS payments silently stall", "cause": "Treating a created PaymentIntent as paid, missing requires_action", "mitigation": "Map requires_action -> pending; use hosted Checkout so Stripe handles 3DS", "severity": "medium", "source": "https://docs.stripe.com/payments/paymentintents/lifecycle" }
  ],
  "sdks": { "node": "stripe", "php": "stripe/stripe-php", "rest_direct_ok": true },
  "notes": "Zimbabwe is NOT a supported Stripe merchant country for live payouts — a ZW merchant needs an entity in a supported country. Sandbox testing works fine.",
  "sources": [
    "https://docs.stripe.com/api/checkout/sessions",
    "https://docs.stripe.com/webhooks/signature",
    "https://docs.stripe.com/currencies",
    "https://docs.stripe.com/testing"
  ],
  "verification": {
    "verified": true,
    "unverified_fields": ["exact supported-country count"],
    "last_updated": "2026-07-18"
  }
}
