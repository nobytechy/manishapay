{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Noby Payments Knowledge Base — gateway record",
  "description": "One record per payment gateway. Facts synthesized from official docs + developer community; each record carries sources and verification flags. Not official; verify against provider docs before production use.",
  "type": "object",
  "required": ["id", "name", "regions", "currencies", "methods", "auth", "capabilities", "credentials_required", "sources", "verification"],
  "properties": {
    "id": { "type": "string", "description": "stable slug, e.g. 'stripe'" },
    "name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "homepage": { "type": "string", "format": "uri" },
    "docs_url": { "type": "string", "format": "uri" },
    "category": { "type": "string", "enum": ["global-card", "african-aggregator", "zim-aggregator", "sa-gateway", "mobile-money", "wallet"] },
    "regions": { "type": "array", "items": { "type": "string" } },
    "countries": { "type": "array", "items": { "type": "string", "description": "ISO 3166-1 alpha-2" } },
    "currencies": { "type": "array", "items": { "type": "string", "description": "ISO 4217" } },
    "methods": { "type": "array", "items": { "type": "string" }, "description": "rails: card, ecocash, mpesa, eft, ..." },
    "auth": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "description": "e.g. bearer-secret-key, oauth-client-credentials, company-token, hash-signed, aes-encrypted" },
        "key_types": { "type": "array", "items": { "type": "string" } },
        "sandbox_instant": { "type": "boolean", "description": "test keys obtainable instantly, no KYC" },
        "kyc_required_for_live": { "type": "boolean" }
      }
    },
    "initiate": {
      "type": "object",
      "properties": {
        "flow": { "type": "string", "enum": ["redirect", "seamless", "stk-push", "xml-redirect", "form-post-redirect"] },
        "endpoint": { "type": "string" },
        "http_method": { "type": "string" },
        "required_params": { "type": "array", "items": { "type": "string" } },
        "returns": { "type": "array", "items": { "type": "string" } },
        "amount_unit": { "type": "string", "enum": ["major", "minor-subunit", "decimal-2dp", "integer"] }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "mechanisms": { "type": "array", "items": { "type": "string", "enum": ["webhook", "poll", "redirect-return"] } },
        "webhook_verification": { "type": "string", "description": "how the callback signature is verified" },
        "raw_status_values": { "type": "array", "items": { "type": "string" } },
        "status_map": {
          "type": "object",
          "description": "raw gateway status -> canonical: paid|pending|failed|disputed|refunded",
          "additionalProperties": { "type": "string", "enum": ["paid", "pending", "failed", "disputed", "refunded"] }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "redirect": { "type": "boolean" },
        "poll": { "type": "boolean" },
        "webhook": { "type": "boolean" },
        "mobile_push": { "type": "boolean" },
        "refund": { "type": "boolean" },
        "recurring": { "type": "boolean" }
      }
    },
    "credentials_required": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "secret": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "test_credentials": { "type": "object" },
        "test_cards": { "type": "array", "items": { "type": "object" } },
        "notes": { "type": "string" }
      }
    },
    "pain_points": {
      "type": "array",
      "description": "recurring developer problems + how to avoid them — the heart of the dataset",
      "items": {
        "type": "object",
        "required": ["problem", "mitigation"],
        "properties": {
          "problem": { "type": "string" },
          "cause": { "type": "string" },
          "mitigation": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "source": { "type": "string", "format": "uri" }
        }
      }
    },
    "sdks": {
      "type": "object",
      "properties": {
        "node": { "type": "string" },
        "php": { "type": "string" },
        "rest_direct_ok": { "type": "boolean" }
      }
    },
    "notes": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "verification": {
      "type": "object",
      "properties": {
        "verified": { "type": "boolean", "description": "cross-checked against official docs" },
        "unverified_fields": { "type": "array", "items": { "type": "string" } },
        "last_updated": { "type": "string", "description": "ISO date" }
      }
    }
  }
}
