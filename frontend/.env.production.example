# Production env for the SPA. Read at build time by Vite.
#
# These are ALL safe to ship in the bundle — the anon key is meant to be
# public (Supabase RLS + the manishapay_handle_new_user trigger gate it).
#
# After you set the real Supabase URL + anon key, rebuild with `npm run build`
# and re-deploy to ~/public_html/pay/.

# Same-origin path under which the Node API will be mounted on cPanel.
VITE_API_BASE=/api

# Supabase project (the SHARED one used by chikoro/church/manishapay).
# Fill these in before the next build:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON=
